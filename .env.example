# Copia este archivo a .env (NO subas .env a Git). Sin secretos reales.
# Local con SQLite:
DATABASE_URL=sqlite:///data/cargobox.db
# Con Docker Compose se usa PostgreSQL (ver docker-compose.yml):
# DATABASE_URL=postgresql://cargobox:cambia-esta-clave@db:5432/cargobox
POSTGRES_USER=cargobox
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=cargobox
SEED_DEMO=true
UMBRAL_HORAS=24
PORT=8000
