          "Sucursal"
        ],
        "summary": "Cotizar un envío (BR005, historias 1 y 15)",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Operación exitosa"
          },
          "400": {
            "description": "Solicitud mal formada o faltan campos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Dato inválido o regla de validación (p. ej. evidencia obligatoria)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "peso_kg": {
                    "type": "number"
                  },
                  "largo_cm": {
                    "type": "number"
                  },
                  "ancho_cm": {
                    "type": "number"
                  },
                  "alto_cm": {
                    "type": "number"
                  },
                  "destino_ciudad": {
                    "type": "string"
                  },
                  "nivel_servicio": {
                    "type": "string"
                  }
                },
                "required": [
                  "peso_kg",
                  "largo_cm",
                  "ancho_cm",
                  "alto_cm",
                  "destino_ciudad",
                  "nivel_servicio"
                ]
              }
            }
          }
        }
      }
    },
